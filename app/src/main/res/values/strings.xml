    <!-- Home Assistant screen -->
    <string name="ha_section_server">Server</string>
    <string name="ha_version">version %1$s</string>
    <string name="ha_footnote">Connected on this phone or on your paired computer, it works on both: they share the connection over their encrypted link.</string>
    <string name="ha_section_on_wifi">On this Wi-Fi</string>
    <string name="ha_looking">Looking for Home Assistant…</string>
    <string name="ha_none_found">None found by itself. Type its address below.</string>
    <string name="ha_address_label">Address</string>
    <string name="ha_token_label">Long-lived access token</string>
    <string name="ha_token_placeholder">Paste it here</string>
    <string name="ha_token_help_title">Where is the token?</string>
    <string name="ha_token_help_text">In Home Assistant open your profile (your name at the bottom of the sidebar) → **Security**. Under **Long-lived access tokens** tap **Create token**, name it “House Control” and copy it.</string>
    <string name="ha_token_footnote">The token stays on this phone, encrypted with a key that never leaves it, and goes to the computer you paired, over your encrypted link. Lights, switches, climate devices and temperature sensors can then be linked to your plan.</string>
    <string name="confirm_disconnect_ha_title">Disconnect Home Assistant?</string>
    <string name="confirm_disconnect_ha_message">Its devices go back to being simulated, here and on your paired computer.</string>
    <!-- Hue screen -->
    <string name="hue_looking">Looking for Hue Bridges…</string>
    <string name="hue_no_bridge">No bridge found by itself. Type its address below — the Hue app shows it under Settings → My Hue System.</string>
    <string name="hue_section_bridge">Bridge</string>
    <string name="hue_section_or_address">Or by address</string>
    <string name="hue_bridge_address_label">Bridge address</string>
    <string name="hue_address_placeholder">e.g. 192.168.1.20</string>
    <string name="hue_pair_footnote">No account needed: the bridge lets one app in when its button is pressed. The key it gives stays on this phone and your paired computer.</string>
    <string name="hue_press_button">Press the round button on the bridge</string>
    <string name="hue_waiting">%1$s · waiting %2$d s</string>
    <string name="hue_button_timeout">Nobody pressed the button in time. Try again.</string>
    <string name="confirm_disconnect_hue_title">Disconnect the Hue Bridge?</string>
    <string name="confirm_disconnect_hue_message">Its lamps go back to being simulated, here and on your paired computer.</string>
    <!-- Pairing screen -->
    <string name="pairing_invalid_code">That is not a House Control pairing code.</string>
    <string name="pairing_paired_with">Paired with %1$s</string>
    <string name="pairing_paired_detail">Whenever both are on the same Wi-Fi and the app is open, a plan saved on one reaches the other a moment later.</string>
    <string name="pairing_on_computer">On the computer</string>
    <string name="pairing_step_1">Click the house with the right mouse button — in the menu bar on a Mac, in the taskbar\'s tray on a PC — and choose **Pair Phone…** (**Pair iPhone…** in older versions). A code appears.</string>
    <string name="pairing_step_2">The first time, macOS or Windows asks whether House Control may use your local network: allow it.</string>
    <string name="pairing_step_3">Scan the code with this phone.</string>
    <string name="pairing_scan_prompt">Point at the code on the computer</string>
    <string name="pairing_footnote">Or press Copy Pairing Link on the computer, send it to this phone and paste it here. Nothing goes through a server: the two talk over your Wi-Fi with a key only the code carries.</string>
    <!-- Smart Life screen -->
    <string name="smartlife_code_label">Smart Life sign-in code</string>
    <string name="smartlife_code_on_mac">The code is on %1$s</string>
    <string name="smartlife_on_mac_detail">Switch to Smart Life on this phone, tap the scanner on its Home tab and point it at the computer\'s screen. The code stays there while you are away; come back here when you have confirmed.</string>
    <string name="smartlife_scan_title">Scan it with Smart Life on this phone</string>
    <string name="smartlife_step_save">Save the code to the gallery (below).</string>
    <string name="smartlife_step_scan">In Smart Life tap **+** → **Scan**, then the **album** icon, and pick the code.</string>
    <string name="smartlife_step_confirm">Confirm the login and come back here.</string>
    <string name="smartlife_show_elsewhere">Or show it on another screen: share it to a computer or tablet, or pair a Mac or PC and it appears there.</string>
