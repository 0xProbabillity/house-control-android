<?xml version="1.0" encoding="utf-8"?>
<!-- Android 13+ offers these in Settings > App languages. On older versions the app
     follows the system language through the resource qualifiers instead. -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="zh-CN" />
</locale-config>
