<?xml version="1.0" encoding="utf-8"?>
<!-- Home Assistant is usually reached over plain http:// on the home network
     (http://homeassistant.local:8123). Everything on the internet (Tuya, Hue discovery) is https. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
